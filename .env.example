# ====================================================================
# SPORTSENSE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local for development / production
# ====================================================================

# --------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / PWA)
# --------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://byceifewwxvjicrrbdps.supabase.co

# Supabase Anon / Public Key (safe for client-side usage)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# FastAPI Backend URL (http://localhost:8000/api for local dev, or your deployed cloud URL)
VITE_API_BASE_URL=http://localhost:8000/api

# --------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (FastAPI / Python Engine)
# --------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# Backend Supabase Integration
SUPABASE_URL=https://byceifewwxvjicrrbdps.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Allowed CORS origins (comma-separated or '*' for open development)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000,*

# Biomechanical Engine Calibration
GRAVITY=9.80665
MAX_UPLOAD_SIZE_MB=50

# --------------------------------------------------------------------
# 3. PRODUCTION DEPLOYMENT QUICK REFERENCE
# --------------------------------------------------------------------
# - Supabase SQL Migrations:
#   Run scripts located in /supabase/migrations/ in your Supabase SQL Editor.
#
# - Docker Container Run:
#   docker-compose up --build -d
#
# - Cloud Container Hosts (Render / Railway / Fly.io / AWS ECS):
#   Set Docker context to root, Dockerfile path to backend/Dockerfile,
#   and configure the environment variables listed above.
